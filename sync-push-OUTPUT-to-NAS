#!/bin/bash

# Push results from the local directory to the NAS
# This script is user-agnostic: it uses $HOME so other users can run it
# from their accounts where the repo is located at ~/github/within-to-between-hosts

set -euo pipefail

SRC_DIR="$HOME/github/within-to-between-hosts/OUTPUT/"
DST_DIR="/mnt/NAS-small-OUTPUT/within-to-between-hosts"

# Verify source exists
if [ ! -d "$SRC_DIR" ]; then
	echo "Source directory does not exist: $SRC_DIR" >&2
	exit 1
fi

# Ensure destination exists (create if necessary)
mkdir -p "$DST_DIR"

# Perform the sync (preserve attributes, copy recursively, show progress)
# Note: do NOT use --delete so files present only on the destination are preserved.
rsync -av --progress "$SRC_DIR" "$DST_DIR/"

echo "Sync completed: $SRC_DIR -> $DST_DIR"
