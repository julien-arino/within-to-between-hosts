#!/bin/bash

# Exit immediately if a command exits with a non-zero status
set -e

# Record start time
start_time=$(date +%s)

echo "=== Running bash-1-run-sensitivity-analysis ==="
./bash-1-run-sensitivity-analysis

echo "=== Running bash-2-run-cohort ==="
./bash-2-run-cohort

echo "=== Running bash-3-run-between-host ==="
./bash-3-run-between-host

# Record end time
end_time=$(date +%s)
duration=$((end_time - start_time))

# Convert to hours, minutes, seconds
hours=$((duration / 3600))
minutes=$(( (duration % 3600) / 60 ))
seconds=$((duration % 60))

echo "=== All scripts finished successfully ==="
printf "Total run time: %02d:%02d:%02d\n" $hours $minutes $seconds
